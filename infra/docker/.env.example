# Copy to .env and adjust for local development.
# These are DEV-ONLY credentials — never reuse in staging/production.

# --- Postgres ---
POSTGRES_USER=quickbite
POSTGRES_PASSWORD=quickbite_dev_pw
POSTGRES_PORT=5432
# One database per service (created on first container start).
POSTGRES_MULTIPLE_DATABASES=auth_db,restaurant_db,catalog_db,cart_db,order_db,payment_db,notification_db

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=quickbite
RABBITMQ_DEFAULT_PASS=quickbite_dev_pw
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Redis ---
REDIS_PASSWORD=quickbite_dev_pw
REDIS_PORT=6379
