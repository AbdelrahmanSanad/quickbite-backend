# Restaurant Service — copy to .env for local dev.
PORT=3002

# Owns restaurant_db only — never another service's database.
DATABASE_URL="postgresql://quickbite:quickbite_dev_pw@localhost:5432/restaurant_db?schema=public"

# Menu cache.
REDIS_URL="redis://default:quickbite_dev_pw@localhost:6379"

# MUST match the Auth Service secret — tokens are validated locally (stateless).
JWT_ACCESS_SECRET="replace-with-the-shared-access-secret"

# Security
CORS_ORIGINS="http://localhost:3000"
THROTTLE_TTL=60
THROTTLE_LIMIT=100
