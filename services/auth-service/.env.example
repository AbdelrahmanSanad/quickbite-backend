# Auth Service — copy to .env for local dev.
# Points only at this service's own database (auth_db).
DATABASE_URL="postgresql://quickbite:quickbite_dev_pw@localhost:5432/auth_db?schema=public"

# Redis (email verification + password reset codes)
REDIS_URL="redis://default:quickbite_dev_pw@localhost:6379"

# Service HTTP port
PORT=3001

# JWT / sessions
JWT_ACCESS_SECRET="replace-with-a-strong-random-secret"
JWT_ACCESS_TTL=900
REFRESH_TTL=604800
